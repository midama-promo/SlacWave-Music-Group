# SlacWave Music Group — Render deployment
NODE_ENV=production
REQUIRE_NEON_DATABASE=true
APP_URL=https://YOUR-RENDER-SERVICE.onrender.com
PORT=3000

# NEW / DEDICATED Neon database for SlacWave MG only (do not reuse Mid-Ama tables)
SLACWAVE_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate separate random secrets (at least 32 bytes each)
SLACWAVE_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
OTP_HASH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
DOWNLOAD_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Resend OTP + transactional email
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=SlacWave Music Group <no-reply@YOUR-VERIFIED-DOMAIN>
ADMIN_NOTIFICATION_EMAIL=mogaursa4@gmail.com,remoabetswemolefi@gmail.com

# Dedicated Cloudflare R2 bucket for SlacWave MG
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET_NAME=slacwave-mg-assets
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
